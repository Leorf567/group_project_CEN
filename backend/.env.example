# copy to .env.local and fill in
DATABASE_URL=postgres://zebitans:zebitans@localhost:5432/zebitans
TEST_DATABASE_URL=postgres://zebitans:zebitans@localhost:5432/zebitans_test

# any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# where the frontend runs (for CORS)
FRONTEND_ORIGIN=http://localhost:3000

# password used by `npm run db:seed` for the demo accounts
SEED_PASSWORD=zebitans123
